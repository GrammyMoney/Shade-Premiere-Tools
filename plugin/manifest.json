{
  "id": "com.grammymoney.shadelinker",
  "name": "Shade Linker",
  "version": "0.2.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "shadeLinkerPanel",
      "label": {
        "default": "Shade Linker"
      },
      "minimumSize": {
        "width": 240,
        "height": 220
      },
      "maximumSize": {
        "width": 2400,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 380
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 440
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.shade.inc",
        "ws://localhost:19876"
      ]
    },
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": false
  }
}
